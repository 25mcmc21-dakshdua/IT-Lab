# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=3001

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=usermanagement

# Additional MySQL Connection Options (optional)
# DB_CONNECTION_LIMIT=10
# DB_QUEUE_LIMIT=0

# Notes:
# - Do not commit .env to version control
# - Update DB_PASSWORD with your actual MySQL password
# - If using a remote MySQL server, update DB_HOST accordingly
# - Make sure the database specified in DB_NAME exists or will be created
